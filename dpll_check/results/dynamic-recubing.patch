+// Optional dynamic frontier. The GPU callback stays on the calling thread.
+struct RecubeJob {
+    cube: Vec<u32>,
+    conflict_limit: usize,
+    started: bool,
+}
+
+enum RecubeEvent {
+    Finished {
+        owner: usize,
+        job: RecubeJob,
+        first_start: bool,
+        outcome: SearchOutcome,
+        total: SolveStats,
+        split: Vec<u32>,
+    },
+    Failed { owner: usize },
+    Stopped { owner: usize },
